+.empty strong{display:block;color:var(--text);font-weight:500;margin-bottom:4px}
+.empty .btn{margin-top:14px}
+.steps{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
+.steps li{display:grid;grid-template-columns:128px minmax(0,1fr);gap:12px;padding:10px 0;border-bottom:1px solid var(--line)}
+.steps .who{color:var(--muted);font-size:13px}
+.steps .msg{overflow-wrap:anywhere}
+.steps li.warn .msg{color:var(--warn)}.steps li.error .msg{color:var(--bad)}
+.steps time{display:block;color:var(--faint);font-size:12px}
+.kv{display:grid;grid-template-columns:140px minmax(0,1fr);gap:8px 14px;margin-top:10px}
+.kv dt{color:var(--muted)}.kv dd{margin:0;overflow-wrap:anywhere}
+details{border-bottom:1px solid var(--line)}
+details>summary{cursor:pointer;padding:12px 0;list-style:none;display:flex;justify-content:space-between;gap:12px;align-items:center}
+details>summary::-webkit-details-marker{display:none}
+details>summary::after{content:"+";color:var(--muted)}
+details[open]>summary::after{content:"\2212"}
+details .body{padding:0 0 16px;color:var(--muted)}
+details .body pre{white-space:pre-wrap;font:inherit;margin:6px 0 12px;color:var(--text)}
+.table{width:100%;border-collapse:collapse;font-size:13px}
+.table th{text-align:left;color:var(--muted);font-weight:500;padding:8px 10px 8px 0;border-bottom:1px solid var(--line-strong)}
+.table td{padding:9px 10px 9px 0;border-bottom:1px solid var(--line);vertical-align:top}
+.table td.n,.table th.n{text-align:right;font-variant-numeric:tabular-nums}
+.scroll-x{overflow-x:auto}
+.note{color:var(--muted);font-size:13px;max-width:62ch}
+.err{color:var(--bad)}
+.skeleton{height:14px;border-radius:6px;background:linear-gradient(90deg,var(--surface),var(--raised),var(--surface));background-size:200% 100%;animation:sh 1.4s linear infinite;margin:14px 0}
+@keyframes sh{to{background-position:-200% 0}}
+.gate{max-width:420px;margin:12vh auto 0}
+.gate p{color:var(--muted);margin:8px 0 18px}
+.jarvis{position:fixed;left:var(--nav-w);right:0;bottom:0;padding:10px clamp(12px,4vw,48px) calc(10px + env(safe-area-inset-bottom));background:linear-gradient(to top,var(--bg) 70%,transparent);pointer-events:none}
+.jarvis>*{pointer-events:auto;max-width:880px}
+.jarvis-reply{color:var(--muted);font-size:13px;margin:0 0 8px 4px;max-height:4.6em;overflow:auto;overflow-wrap:anywhere}
+.jarvis-reply:empty{display:none}
+.jarvis-bar{display:flex;gap:8px;align-items:center;background:var(--surface);border:1px solid var(--line-strong);border-radius:14px;padding:6px 6px 6px 6px;box-shadow:0 6px 24px rgba(0,0,0,.45)}
+.jarvis-bar:focus-within{border-color:#3c444e}
+.jarvis-input{flex:1;min-width:0;background:none;border:0;color:var(--text);font:inherit;padding:8px 4px;outline:none}
+.jarvis-input::placeholder{color:var(--faint)}
+.toast{position:fixed;top:16px;left:50%;transform:translateX(-50%);background:var(--raised);border:1px solid var(--line-strong);padding:10px 16px;border-radius:10px;max-width:min(92vw,460px);z-index:9900;box-shadow:0 8px 30px rgba(0,0,0,.5)}
+.toast.bad{border-color:color-mix(in oklab,var(--bad) 55%,transparent)}
+.hint-chip{all:unset;cursor:pointer;color:var(--accent);text-decoration:underline;text-underline-offset:3px}
+/* Reel Studio overlay (existing renderer) restyled to match */
+#reelStudio{background:rgba(11,12,14,.97)!important;font-family:var(--font)!important}
+#reelStudio .reelCard{background:var(--surface)!important;border:1px solid var(--line)!important;border-radius:var(--r)!important}
+#reelStudio .reelBtn{background:var(--raised)!important;border:1px solid var(--line-strong)!important;border-radius:8px!important;color:var(--text)!important}
+#reelStudio .reelBtn.green{background:var(--accent)!important;color:var(--accent-ink)!important;border-color:transparent!important}
+#reelStudio .reelField{background:var(--bg)!important;border:1px solid var(--line-strong)!important}
+#reelStudio #reelMessage{background:var(--raised)!important;color:var(--text)!important;border:1px solid var(--line-strong)}
+@media (max-width:760px){
+  .shell{grid-template-columns:minmax(0,1fr)}
+  .nav{position:fixed;inset:auto 0 0 0;height:var(--bar-h);width:100%;flex-direction:row;padding:6px 6px calc(6px + env(safe-area-inset-bottom));border-right:0;border-top:1px solid var(--line);z-index:50;gap:0;justify-content:space-around;height:auto}
+  .brand{display:none}
+  .nav button{flex-direction:column;gap:2px;padding:6px 4px;font-size:10.5px;flex:1;justify-content:center;text-align:center;min-width:0}
+  .nav button span.lbl{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+  .nav .badge{position:absolute;top:2px;right:calc(50% - 20px);margin:0}
+  .main{padding:20px 16px 190px}
+  .jarvis{left:0;bottom:calc(var(--bar-h) + env(safe-area-inset-bottom) + 6px);padding:8px 12px}
+  .steps li{grid-template-columns:1fr;gap:2px}
+  .kv{grid-template-columns:1fr}
+  .row{flex-direction:column;gap:10px}.row .actions{justify-content:flex-start}
+}
+@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
